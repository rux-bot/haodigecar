{
  "name": "commercial-vehicle-catalog",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": { "node": ">=24.15.0" },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:ui": "vite --host 127.0.0.1",
    "dev:api": "node --watch server/index.mjs",
    "build": "tsc -b && vite build",
    "build:preview": "tsc -b && node scripts/build-preview.mjs",
    "package:deploy": "node scripts/package-deploy.mjs",
    "start": "node server/index.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "express": "^5.3.0",
    "lucide-react": "^1.60.0",
    "multer": "^2.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "~5.9.3",
    "vite": "^8.3.4"
  }
}
